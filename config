ngx_addon_name=ngx_stream_upstream_check_module

if [ "$ngx_module_link" = DYNAMIC ]; then
    echo "$0: error: $ngx_addon_name patches the nginx core; build it with --add-module, not --add-dynamic-module"
    exit 1
fi

have=NGX_STREAM_UPSTREAM_CHECK . auto/have

ngx_module_type=STREAM
ngx_module_name=ngx_stream_upstream_check_module
ngx_module_incs=$ngx_addon_dir
ngx_module_deps=$ngx_addon_dir/ngx_stream_upstream_check_module.h
ngx_module_srcs=$ngx_addon_dir/ngx_stream_upstream_check_module.c
ngx_module_libs=
. auto/module

ngx_module_type=HTTP
ngx_module_name=ngx_stream_upstream_check_status_module
ngx_module_incs=
ngx_module_deps=
ngx_module_srcs=
ngx_module_libs=
. auto/module
